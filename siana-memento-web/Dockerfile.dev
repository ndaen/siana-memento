# Image de dev pour le front Next.js — hot reload via `next dev`.
FROM node:22-alpine

# libc6-compat : requis par le binaire SWC de Next sur Alpine/musl.
RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

# Surchargé par compose (-H 0.0.0.0) ; conservé pour un usage standalone.
CMD ["npm", "run", "dev"]
