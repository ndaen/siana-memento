# Image de dev pour l'API AdonisJS — hot reload via `node ace serve --hmr`.
FROM node:22-alpine

# libc6-compat aide certains binaires natifs (ex. @swc/core) sur Alpine/musl.
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Dépendances d'abord pour profiter du cache de layers ; les sources sont bind-montées au runtime.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3333

# Surchargé par compose (qui lance les migrations avant) ; conservé pour un usage standalone.
CMD ["node", "ace", "serve", "--hmr"]
